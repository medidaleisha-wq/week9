#include <stdio.h>
#include <stdlib.h>

#define MIN(x,y) (x > y ? y : x)

int main()
{
    int orate, drop = 0, cap, x, count = 0;
    int inp[10] = {0};
    int i = 0, nsec, ch;

    scanf("%d", &cap);
    scanf("%d", &orate);

    do
    {
        scanf("%d", &inp[i]);
        i++;

        scanf("%d", &ch);
    } while(ch);

    nsec = i;

    printf("\nSecond\tReceived\tSent\tDropped\tRemaining");

    for(i = 0; count || i < nsec; i++)
    {
        printf("%d\t", i + 1);
        printf("%d\t", inp[i]);
        printf("%d\t", MIN((inp[i] + count), orate));

        x = inp[i] + count - orate;

        if(x > 0)
        {
            if(x > cap)
            {
                count = cap;
                drop = x - cap;
            }
            else
            {
                count = x;
                drop = 0;
            }
        }
        else
        {
            count = 0;
            drop = 0;
        }

        printf("%d\t%d", drop, count);
    }

    return 0;
}
